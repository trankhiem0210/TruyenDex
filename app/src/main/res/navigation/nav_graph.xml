<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <action
        android:id="@+id/open_novel_detail"
        app:destination="@id/nav_novel_detail"
        app:enterAnim="@anim/screen_enter"
        app:exitAnim="@anim/screen_exit"
        app:popEnterAnim="@anim/screen_return"
        app:popExitAnim="@anim/screen_leave" />

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.truyendex.features.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_explore"
        android:name="com.example.truyendex.features.search.SearchFragment"
        android:label="@string/nav_explore"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/nav_library"
        android:name="com.example.truyendex.features.library.LibraryFragment"
        android:label="@string/nav_library"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/nav_account"
        android:name="com.example.truyendex.features.account.AccountFragment"
        android:label="@string/nav_account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/nav_novel_detail"
        android:name="com.example.truyendex.features.novel.NovelDetailFragment"
        android:label="Chi tiết truyện"
        tools:layout="@layout/fragment_novel_detail" />
</navigation>
