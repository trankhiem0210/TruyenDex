<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Tài khoản"
            android:textColor="?attr/colorInk"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/account_card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/textAvatarInitials"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/account_avatar_background"
                android:gravity="center"
                android:text="T"
                android:textColor="?attr/colorBrand"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textDisplayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Người đọc"
                    android:textColor="?attr/colorInk"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAccountEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="email@example.com"
                    android:textColor="?attr/colorMuted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textSignInMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đăng nhập bằng email/mật khẩu"
                    android:textColor="?attr/colorMuted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/buttonEditDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="Đổi tên hiển thị"
                    android:textColor="?attr/colorBrand"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="Thông tin cá nhân"
            android:textColor="?attr/colorInk"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/account_card_background"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/buttonChangePassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="Đổi mật khẩu"
                android:textColor="?attr/colorInk"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textPasswordManagementInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="?attr/colorMuted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="?attr/colorSurface"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textColor="?attr/colorError"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
