<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.TruyenDex.Home.ThemeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconSize">@dimen/home_icon_size</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/home_choice_text</item>
        <item name="backgroundTint">@color/home_clear</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="Widget.TruyenDex.Home.RankButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/home_choice_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/spacing_xs</item>
        <item name="android:paddingEnd">@dimen/spacing_xs</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/home_rank_tint</item>
    </style>

    <style name="Widget.TruyenDex.Home.GenreChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/home_choice_text</item>
        <item name="chipBackgroundColor">@color/home_chip_background</item>
        <item name="chipStrokeColor">@color/home_chip_stroke</item>
    </style>

    <style name="Widget.TruyenDex.Home.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>
</resources>
